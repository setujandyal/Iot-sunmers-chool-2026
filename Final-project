// ---------------- HANDLERS ----------------
void handleRoot() {
  server.send_P(200, "text/html", DASHBOARD_HTML);
}

float readWeightGrams() {
  if (DEMO_MODE) {
    float t = millis() / 1000.0;
    return 50 + (1050 - 50) * 0.6 + sin(t / 30.0) * 5 - fmod(t, 6000.0) / 20.0;
  }
  if (scale.is_ready()) {
    lastWeightG = scale.get_units(5) + TARE_OFFSET_G;  // average of 5 readings
    return lastWeightG;
  }
  return lastWeightG; // last known good value if HX711 isn't responding this cycle
}

void handleData() {
  float weight = readWeightGrams();
  String json = "{";
  json += "\"weight_g\":" + String(weight, 2) + ",";
  json += "\"timestamp\":" + String(millis());
  json += "}";
  server.send(200, "application/json", json);
}

void setup() {
  Serial.begin(115200);

  if (!DEMO_MODE) {
    scale.begin(HX711_DT_PIN, HX711_SCK_PIN);
    scale.set_scale(CALIBRATION_FACTOR);
    scale.tare(); // do this with the platform empty, nothing touching it
  }

  WiFi.softAP(AP_SSID, AP_PASS);
  Serial.print("Access Point started: ");
  Serial.println(AP_SSID);
  Serial.print("Open in browser: http://");
  Serial.println(WiFi.softAPIP());

  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.begin();
}

void loop() {
  server.handleClient();
}


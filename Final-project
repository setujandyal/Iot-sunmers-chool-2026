<script>
  const EMPTY_WEIGHT_G = 50;
  const FULL_WEIGHT_G  = 1050;
  const POLL_MS = 3000;
  const pctValue=document.getElementById('pctValue'), weightSub=document.getElementById('weightSub'),
    daysValue=document.getElementById('daysValue'), rateValue=document.getElementById('rateValue'),
    needleGroup=document.getElementById('needleGroup'), statusDot=document.getElementById('statusDot'),
    statusText=document.getElementById('statusText'), alertBanner=document.getElementById('alertBanner'),
    footerText=document.getElementById('footerText'), trendCanvas=document.getElementById('trend'),
    ctx=trendCanvas.getContext('2d');
  let history=[];
  function setNeedle(p){ needleGroup.style.transform = `rotate(${-90+(p/100)*180}deg)`; }
  function updateAlert(p){
    if(p<=10){alertBanner.className='alert-banner critical';alertBanner.textContent='Critical: nearly empty';}
    else if(p<=25){alertBanner.className='alert-banner low';alertBanner.textContent='Running low';}
    else{alertBanner.className='alert-banner';alertBanner.textContent='';}
  }
  function drawTrend(){
    const w=trendCanvas.width,h=trendCanvas.height; ctx.clearRect(0,0,w,h);
    if(history.length<2) return;
    const weights=history.map(p=>p.weight), max=Math.max(...weights), min=Math.min(...weights), range=(max-min)||1;
    const stepX=w/(history.length-1);
    ctx.beginPath();
    history.forEach((p,i)=>{const x=i*stepX, y=h-((p.weight-min)/range)*(h-20)-10; i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);});
    ctx.strokeStyle='#3ddc97'; ctx.lineWidth=2; ctx.stroke();
    ctx.lineTo(w,h); ctx.lineTo(0,h); ctx.closePath(); ctx.fillStyle='rgba(61,220,151,0.08)'; ctx.fill();
  }
  function applyReading(data){
    const weight=data.weight_g;
    const usableWeight=Math.max(0,Math.min(FULL_WEIGHT_G-EMPTY_WEIGHT_G, weight-EMPTY_WEIGHT_G));
    const fullRange=FULL_WEIGHT_G-EMPTY_WEIGHT_G;
    const percent=Math.round((usableWeight/fullRange)*100);
    pctValue.textContent=percent; weightSub.textContent=`${weight.toFixed(1)} g on load cell`;
    setNeedle(percent); updateAlert(percent);
    history.push({t:Date.now(),weight:weight}); if(history.length>40) history.shift();
    drawTrend();
    if(history.length>=2){
      const first=history[0], last=history[history.length-1];
      const hoursElapsed=(last.t-first.t)/3600000, gramsUsed=first.weight-last.weight;
      if(hoursElapsed>0.01 && gramsUsed>0){
        const ratePerHour=gramsUsed/hoursElapsed;
        rateValue.textContent=ratePerHour.toFixed(1);
        daysValue.textContent= ratePerHour>0 ? Math.max(0,Math.round(usableWeight/ratePerHour)) : '--';
      } else { rateValue.textContent='0.0'; daysValue.textContent='--'; }
    }
    footerText.textContent=`Last updated ${new Date().toLocaleTimeString()}`;
    statusDot.className='dot'; statusText.textContent='Live';
  }
  async function poll(){
    try{
      const res=await fetch('/data',{cache:'no-store'});
      if(!res.ok) throw new Error('bad response');
      applyReading(await res.json());
    }catch(err){ statusDot.className='dot offline'; statusText.textContent='Offline'; }
  }
  poll(); setInterval(poll, POLL_MS);
</script>
